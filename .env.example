# Copy to .env and fill values. Never commit .env.

GEMINI_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
FAL_KEY=
# FAL_API_KEY=                 # alias accepted by setup / media pack
# KAGEHA_FAL_IMAGE_MODEL=flux-schnell   # default for fal_generate_image (flux|flux-schnell)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Azure OpenAI (openai_compat provider "azure" in models.yaml)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# KAGEHA_EMBEDDING_PROVIDER=azure
# KAGEHA_EMBEDDING_MODEL=text-embedding-3-large
# KAGEHA_EMBEDDING_DIMENSIONS=3072

# Optional: web_search providers (auto prefers first keyed API)
# Order: Brave → Tavily → Perplexity → Gemini grounding → DuckDuckGo
# BRAVE_API_KEY=            # https://api-dashboard.search.brave.com/
# TAVILY_API_KEY=           # https://app.tavily.com/
# PERPLEXITY_API_KEY=       # https://www.perplexity.ai/settings/api
# KAGEHA_WEB_SEARCH=auto    # auto|brave|tavily|perplexity|gemini|ddg|gemini_only
# KAGEHA_BRAVE_COUNT=8
# KAGEHA_TAVILY_COUNT=8
# KAGEHA_TAVILY_DEPTH=basic
# KAGEHA_PERPLEXITY_COUNT=8
#
# Blink research backend (core pack: research_run / parallel_web_fetch / headless_fetch)
# KAGEHA_RESEARCH_DEPTH=flash          # flash|standard|deep
# KAGEHA_RESEARCH_MAX_URLS=5
# KAGEHA_RESEARCH_MAX_QUERIES=4
# KAGEHA_RESEARCH_CACHE_TTL=600        # seconds; 0 disables
# KAGEHA_HEADLESS_BACKEND=auto         # auto|http|chromium|lightpanda|cdp
# KAGEHA_HEADLESS_CDP=http://127.0.0.1:9222   # Lightpanda: `lightpanda serve --port 9222`
# KAGEHA_HEADLESS_MAX_PAGES=4


# Optional channels
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs. Empty means deny all users.
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_ALLOW_ALL_USERS=1  # development only
# WhatsApp QR / Baileys (experimental)
# WHATSAPP_QR_ALLOWED_USERS=
# WHATSAPP_QR_ALLOW_ALL_USERS=1  # development only
# KAGEHA_WA_AUTH_DIR=~/.kageha/platforms/whatsapp/session
# WHATSAPP_QR_ENABLED=1

# OAuth connections (kageha connect list|login|status|logout|credentials)
# GitHub OAuth App with Device Flow enabled
# GITHUB_OAUTH_CLIENT_ID=
# Optional allowlist (default: gmail,gcal,gdrive,github)
# KAGEHA_CONNECTIONS_ALLOWLIST=gmail,github
# Gmail OAuth client (used by `kageha connect login gmail`)
# GOOGLE_OAUTH_CLIENT_JSON=~/.kageha/connections/google-client.json
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

KAGEHA_HOME=~/.kageha
KAGEHA_SKILLS_PATH=
# Optional: colon-separated custom tool pack dirs (also ~/.kageha/tools/)
# KAGEHA_TOOLS_PATH=
# Optional: import Cursor/Claude Desktop MCP configs
# KAGEHA_MCP_IMPORT_HOST=1
KAGEHA_MAX_STEPS=40
KAGEHA_MAX_USD=2.0

# Default: run shell when OS isolation isn't available; risky tools still HITL.
# Use `strict` only when seatbelt/bwrap/docker is present — otherwise bash is
# denied and the agent can't run code / build binary deliverables.
KAGEHA_SECURITY_PROFILE=approval_fallback
# Optional OpenTelemetry HTTP endpoint. Local metrics/traces are always retained.
# KAGEHA_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Long-lived `kageha chat`, `kageha webui`, and `kageha server` commands start
# the channels worker when a Telegram token or WHATSAPP_QR_ENABLED is set.

# Shell OS sandbox: auto | seatbelt | bwrap | docker | ssh | off
# KAGEHA_SANDBOX=auto
# KAGEHA_SANDBOX_WORKSPACE_ACCESS=rw
# KAGEHA_SANDBOX_READ_ONLY_ROOT=1
# KAGEHA_SANDBOX_DOCKER_IMAGE=python:3.12-slim
# KAGEHA_SANDBOX_DOCKER_BINDS=
# KAGEHA_SANDBOX_SSH_HOST=
# KAGEHA_SANDBOX_SSH_USER=
# KAGEHA_SANDBOX_SSH_PORT=22
# KAGEHA_SANDBOX_SSH_IDENTITY=
# KAGEHA_SANDBOX_SSH_WORKDIR=/tmp/kageha-work

# Browser: headless | comet | docker
# KAGEHA_BROWSER_MODE=headless
# KAGEHA_BROWSER_DOCKER_IMAGE=browserless/chrome:latest

# Curator schedule interval for `kageha daemon` (7d / 24h / seconds)
# KAGEHA_CURATOR_CRON=7d


# Browser: use logged-in Comet via CDP (`/comet` or `/browser comet` in chat)
# Prefer `/browser use comet` (persists ~/.kageha/browser.json + enables pack).
KAGEHA_BROWSER_MODE=comet
KAGEHA_COMET_CDP=http://127.0.0.1:9222
# KAGEHA_BROWSER_PACK=1          # force-enable optional browser tools
# KAGEHA_COMET_PROFILE=~/Library/Application Support/Comet

# Android / Google TV via adb — skill: android_tv (skill_run scripts; not a tool pack)
# Install platform-tools; enable Network debugging on the TV; accept RSA prompt.
# KAGEHA_ANDROID_TV_HOST=192.168.1.50
# KAGEHA_ANDROID_TV_PORT=5555
# KAGEHA_ANDROID_TV_SERIAL=192.168.1.50:5555

# Sony Bravia IP control (PIN cookie pairing or PSK) — skill: sony_bravia
#   uv run kageha bravia discover
#   uv run kageha bravia pair
# KAGEHA_BRAVIA_HOST=10.0.0.14
# KAGEHA_BRAVIA_PSK=

# Optional native tool packs (default core: forge,skills,mcp,memory,subagent,research)
# KAGEHA_TOOL_PACKS=browser,media
# KAGEHA_TOOL_PACKS=all



# Provenance-aware memory (SQLite/FTS5 authority; vectors are optional derivatives)
KAGEHA_MEMORY_ENABLED=1
KAGEHA_MEMORY_LEARN=1
KAGEHA_MEMORY_MIN_SCORE=0.45
KAGEHA_MEMORY_MAX_RESULTS=6
# auto = enable zvec memory whenever an embedding model/key is defined; else FTS-only
KAGEHA_MEMORY_EMBEDDINGS=auto
KAGEHA_MEMORY_MODEL_ROLE=fast_worker
# LLM extract on verified successful turns (auto|on|off); regex always remains
KAGEHA_MEMORY_LLM_EXTRACT=auto
KAGEHA_MEMORY_LLM_EXTRACT_TIMEOUT=8
# Consolidate/dream cooldown hours (0 = every idle pass)
KAGEHA_MEMORY_CONSOLIDATE_HOURS=6
# Hash-gated AGENTS.md/CLAUDE.md/.cursor/rules sync on turn start (auto|on|off)
KAGEHA_MEMORY_AUTO_SYNC_RULES=auto
# Optional LLM dream during consolidate (off|auto|on); SQLite stays authority
KAGEHA_MEMORY_LLM_DREAM=off
KAGEHA_MEMORY_LLM_DREAM_TIMEOUT=12
# KAGEHA_MEMORY_EMBEDDINGS=off
# KAGEHA_MEMORY_EMBEDDINGS=zvec
# KAGEHA_MEMORY_EMBEDDINGS=vgrag

# Embedding model (also gates memory semantic accelerator when EMBEDDINGS=auto)
# KAGEHA_EMBEDDING_PROVIDER=gemini
# KAGEHA_EMBEDDING_MODEL=gemini-embedding-001
# KAGEHA_EMBEDDING_DIMENSIONS=768
# KAGEHA_SKILL_EMBEDDINGS=auto   # auto | off | force
# Minimum combined match score before L2 skill body autoload (default 3)
# KAGEHA_SKILL_AUTOLOAD_MIN=3
# Rebuild cache: uv run kageha skills reindex
# Rebuild memory vectors: uv run kageha memory reindex

# Gemini TTS (tool: gemini_tts) — provider must be gemini
# KAGEHA_VOICE_PROVIDER=gemini
# KAGEHA_VOICE_MODEL=gemini-3.1-flash-tts-preview
# KAGEHA_VOICE_NAME=Kore
